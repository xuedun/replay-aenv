#!/usr/bin/env python3
"""Write N exact 1 MiB payload files for pause/snapshot sizing tests."""

from __future__ import annotations

import argparse
import json
import os
import shutil
from pathlib import Path


FILE_SIZE_BYTES = 1024 * 1024
OUTPUT_DIR = Path(os.environ.get("WRITE_TXT_OUTPUT_DIR", "/snapshot-payload"))
FILE_PREFIX = "payload_"


def non_negative_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("file_count must be an integer") from exc
    if parsed < 0:
        raise argparse.ArgumentTypeError("file_count must be non-negative")
    return parsed


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="writeTxt",
        description="Write FILE_COUNT high-entropy files, exactly 1 MiB each.",
    )
    parser.add_argument("file_count", type=non_negative_int)
    args = parser.parse_args()

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    # The directory is dedicated to this tool.  Cleaning only our own known
    # names makes repeated calls produce exactly file_count files as well.
    for path in OUTPUT_DIR.glob(f"{FILE_PREFIX}*.txt"):
        if path.is_file():
            path.unlink()
    for path in OUTPUT_DIR.glob(f".{FILE_PREFIX}*.tmp"):
        if path.is_file():
            path.unlink()

    required_bytes = args.file_count * FILE_SIZE_BYTES
    free_bytes = shutil.disk_usage(OUTPUT_DIR).free
    if required_bytes > free_bytes:
        parser.error(
            f"insufficient free space: need {required_bytes} bytes, "
            f"have {free_bytes} bytes"
        )

    for index in range(args.file_count):
        final_path = OUTPUT_DIR / f"{FILE_PREFIX}{index:08d}.txt"
        temporary_path = OUTPUT_DIR / f".{FILE_PREFIX}{index:08d}.tmp"
        with temporary_path.open("wb") as output:
            output.write(os.urandom(FILE_SIZE_BYTES))
            output.flush()
            os.fsync(output.fileno())
        temporary_path.replace(final_path)

    result = {
        "files": args.file_count,
        "bytes_per_file": FILE_SIZE_BYTES,
        "total_bytes": required_bytes,
        "output_dir": str(OUTPUT_DIR),
    }
    print(json.dumps(result, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
